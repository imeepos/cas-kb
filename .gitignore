# 编译产物
/kb
*.test

# 编辑器与系统文件
.DS_Store
*.swp

# 本地环境(凭据只走环境变量,不入库不入仓)
.env

# devloop 会话账本(harness 本地状态,不入库)
.devloop/
.env.*

# GC 分支表备份(e2e/运维产物,不入库)
/branches-backup-*.json

# 库备份(backup.sh / kb backup 产物,只留本地/归档,不入仓)
/backups/
/caskb-*-backup-*.sql
# kb backup 的 .ckb 快照产物会落在运行时的 cwd,全目录忽略
*.ckb
